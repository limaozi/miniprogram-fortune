/**app.wxss**/
.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
} 

button {
  background: initial;
}

button:focus{
  outline: 0;
}

button::after{
  border: none;
}


page {
  background: #f6f6f6;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
}
.question-container {
    flex: 1;
    display: flex;
    flex-direction: column;
  }
  
  .question-card {
    background: rgba(255, 255, 255, 0.1);
    border-radius: 20rpx;
    padding: 40rpx;
    margin-bottom: 40rpx;
    backdrop-filter: blur(10px);
  }
  
  .question-text {
    font-size: 32rpx;
    color: #ffffff;
    line-height: 1.6;
    font-family: 'PingFang SC', sans-serif;
  }
  
  .options-container {
    display: flex;
    flex-direction: column;
    gap: 20rpx;
    margin-bottom: 30rpx;
  }
  
  .option-item {
    background: rgba(255, 255, 255, 0.1);
    border-radius: 15rpx;
    padding: 30rpx;
    border: 2rpx solid transparent;
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    gap: 20rpx;
  }
  
  .option-item.selected {
    background: rgba(102, 126, 234, 0.3);
    border-color: #667eea;
    box-shadow: 0 0 20rpx rgba(102, 126, 234, 0.3);
  }
  
  .option-indicator {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  
  .option-circle {
    width: 40rpx;
    height: 40rpx;
    border-radius: 50%;
    border: 3rpx solid rgba(255, 255, 255, 0.5);
    background: transparent;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
  }
  
  .option-circle.checked {
    border-color: #667eea;
    background: #667eea;
  }
  
  .option-checkmark {
    width: 20rpx;
    height: 20rpx;
    border: 3rpx solid #ffffff;
    border-top: none;
    border-right: none;
    transform: rotate(-45deg);
    margin-top: -4rpx;
  }
  
  .option-text {
    font-size: 30rpx;
    color: #ffffff;
    font-family: 'PingFang SC', sans-serif;
    flex: 1;
  }
  
  .button-container {
    margin-top: 20rpx;
    margin-bottom: 20rpx;
    text-align: center; 
    align-items: center; 
    justify-content: center;
    display: inline-flex;
  }
  
  .submit-button {
    width: 100%;
    height: 100rpx;
    border-radius: 50rpx;
    border: none;
    background: rgba(255, 255, 255, 0.2);
    color: rgba(255, 255, 255, 0.5);
    font-size: 32rpx;
    font-weight: 500;
    transition: all 0.3s ease;
    text-align: center; 
    align-items: center; 
    justify-content: center;
    display: inline-flex;
  }
  
  .submit-button.active {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: #ffffff;
  }
  
  .submit-button:active {
    transform: scale(0.98);
  }
  /* 加载状态 */
.loading-container {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  padding: 100rpx 0;
}

.loading-spinner {
  width: 80rpx;
  height: 80rpx;
  border: 6rpx solid rgba(255, 255, 255, 0.2);
  border-top-color: #667eea;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 40rpx;
}

@keyframes spin {
  0% {
    transform: rotate(0deg);
  }
  100% {
    transform: rotate(360deg);
  }
}

.loading-text {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
  font-family: 'PingFang SC', sans-serif;
}

.spinner-bottom {
  position: absolute;
  bottom: 20rpx;
  width: 100%;
  display: flex;
  justify-content: center;
  align-items: center;
}

  