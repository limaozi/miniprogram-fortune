/** love/analysis.wxss **/

page {
  background: radial-gradient(circle at top, #111827 0, #020617 50%, #000 100%);
  min-height: 100vh;
}

.analysis-container {
  width: 100%;
  min-height: 100vh;
  padding: 40rpx 30rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  background: radial-gradient(circle at top, #111827 0, #020617 50%, #000 100%);
}

.analysis-header {
  display: flex;
  justify-content: center;
  align-items: center;
  margin-bottom: 30rpx;
}

.analysis-title {
  font-size: 48rpx;
  font-weight: 600;
  color: #ffffff;
  font-family: 'PingFang SC', sans-serif;
}

.analysis-content {
  flex: 1;
  background: rgba(0, 0, 0, 0.3);
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  overflow-y: auto;
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.2);
  backdrop-filter: blur(10px);
}

.analysis-text-block {
  width: 100%;
}

.analysis-text {
  font-size: 28rpx;
  color: #ffffff;
  line-height: 2;
  white-space: pre-wrap;
  word-break: break-word;
  font-family: 'PingFang SC', sans-serif;
}

.button-group {
  display: flex;
  flex-direction: column;
  gap: 15rpx;
}


.button-text {
  font-family: 'PingFang SC', sans-serif;
}

/* 答题回顾模态框 */
.answers-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.8);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 1000;
}

.modal-content {
  width: 90%;
  max-width: 600rpx;
  height: 80%;
  background: rgba(0, 0, 0, 0.6);
  border-radius: 20rpx;
  display: flex;
  flex-direction: column;
  box-shadow: 0 10rpx 40rpx rgba(0, 0, 0, 0.3);
  backdrop-filter: blur(10px);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.1);
}

.modal-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #ffffff;
  font-family: 'PingFang SC', sans-serif;
}

.close-btn {
  font-size: 48rpx;
  color: rgba(255, 255, 255, 0.7);
  cursor: pointer;
}

.answers-scroll {
  flex: 1;
  overflow-y: auto;
  padding: 0 30rpx;
}

.answer-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.1);
}

.answer-question {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: #ffffff;
  margin-bottom: 10rpx;
  font-family: 'PingFang SC', sans-serif;
}

.answer-text {
  display: block;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.7);
  line-height: 1.5;
  font-family: 'PingFang SC', sans-serif;
}
