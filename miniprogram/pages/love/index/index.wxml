<!-- 情感咨询测试页面 -->
<view class="love-container">
  <view class="love-header">
    <text class="love-title">情感咨询</text>
    <text class="question-counter" wx:if="{{!showResult && !isLoading}}">第 {{currentQuestion + 1}} / {{totalQuestions}} 题</text>
  </view>
  
  <!-- 问题和选项 -->
  <view class="question-container" wx:if="{{!showResult && !isLoading}}">
    <view class="question-card">
      <text class="question-text">{{currentQuestionData.question}}</text>
    </view>
    
    <scroll-view class="options-scroll" scroll-y="true">
      <view class="options-container">
        <view 
          class="review-option {{selectedOption === idx ? 'selected' : ''}}"
          wx:for="{{currentQuestionData.options}}"
          wx:key="index"
          wx:for-index="idx"
          bindtap="selectOption"
          data-index="{{idx}}"
        >
          <view class="option-indicator">
            <view class="option-circle {{selectedOption === idx ? 'checked' : ''}}">
              <view class="option-checkmark" wx:if="{{selectedOption === idx}}"></view>
            </view>
          </view>
          <text class="option-text">{{item}}</text>
        </view>
      </view>
    </scroll-view>
    
    <view class="button-container">
      <button 
        class="restart-button {{selectedOption !== null ? 'active' : ''}}"
        bindtap="nextQuestion"
        disabled="{{selectedOption === null}}"
      >
        {{currentQuestion < totalQuestions - 1 ? '下一题' : '提交测试'}}
      </button>
    </view>
  </view>
  
  <!-- 加载状态 -->
  <view class="spinner-bottom" wx:if="{{isLoading}}">
    <view class="loading-container">
      <view class="loading-spinner"></view>
      <text class="loading-text">{{loadingText}}</text>
    </view>
  </view>
  
  <!-- 结果Swiper -->
  <swiper 
    class="result-swiper" 
    wx:if="{{showResult}}"
    current="{{resultPage}}"
    bindchange="onResultSwiperChange"
    style="height: 100vh;"
  >
    <!-- 回顾页面 -->
    <swiper-item>
      <view class="review-container">
        <view class="review-header">
          <text class="review-title">测试回顾</text>
          <text class="swipe-hint-text-small">右滑查看分析 →</text>
        </view>
        <scroll-view 
          class="review-content" 
          scroll-y="{{true}}"
          style="height: {{reviewScrollHeight}}rpx;"
        >
          <view class="review-list">
            <view 
              class="review-item"
              wx:for="{{questions}}"
              wx:key="index"
              wx:for-index="qIdx"
            >
              <view class="review-question-card">
                <text class="review-question-number">第{{qIdx + 1}}题</text>
                <text class="review-question-text">{{item.question}}</text>
              </view>
              <view class="review-options">
                <view 
                  class="review-option {{answers[qIdx] && answers[qIdx].selectedIndex === oIdx ? 'selected' : ''}}"
                  wx:for="{{item.options}}"
                  wx:key="index"
                  wx:for-index="oIdx"
                  wx:if="{{answers[qIdx] && answers[qIdx].selectedIndex === oIdx}}"
                >
                  <view class="review-option-indicator">
                    <view class="option-circle {{answers[qIdx] && answers[qIdx].selectedIndex === oIdx ? 'checked' : ''}}">
                      <view class="option-checkmark" wx:if="{{answers[qIdx] && answers[qIdx].selectedIndex === oIdx}}"></view>
                    </view>
                  </view>
                  <text class="option-text">{{item}}</text>
                </view>
              </view>
            </view>
          </view>
        </scroll-view>
      </view>
    </swiper-item>
    
    <!-- 分析结果页面 -->
    <swiper-item>
      <view class="result-container">
        <view class="result-header">
          <text class="review-title">分析结果</text>
        </view>
        <scroll-view 
          class="result-content" 
          scroll-y="{{true}}"
          style="height: {{resultScrollHeight}}rpx;"
        >
          <text class="result-text">{{analysis}}</text>
        </scroll-view>
        <view class="result-buttons">
          <button class="restart-button" bindtap="restartTest">重新测试</button>
          <button class="back-button" bindtap="goHome">返回首页</button>
        </view>
      </view>
    </swiper-item>
  </swiper>
</view>
