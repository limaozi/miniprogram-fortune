/** love/index.wxss **/

page {
  background: radial-gradient(circle at top, #111827 0, #020617 50%, #000 100%);
  min-height: 100vh;
}

.love-container {
  width: 100%;
  min-height: 100vh;
  padding: 20rpx 20rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  background: radial-gradient(circle at top, #111827 0, #020617 50%, #000 100%);
}

.love-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 60rpx;
  padding-top: 40rpx;
}

.love-title {
  font-size: 48rpx;
  font-weight: 600;
  color: #ffffff;
  margin-bottom: 20rpx;
  font-family: 'PingFang SC', sans-serif;
}




