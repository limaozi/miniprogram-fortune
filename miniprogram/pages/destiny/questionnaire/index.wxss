.container {
  padding: 40rpx;
  min-height: 100vh;
}

.header {
  text-align: center;
  margin-bottom: 60rpx;
}

.title {
  font-size: 48rpx;
  font-weight: 600;
  color: #ffffff;
  margin-bottom: 16rpx;
  text-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.2);
  font-family: 'PingFang SC', sans-serif;
}

.subtitle {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-bottom: 20rpx;
  font-family: 'PingFang SC', sans-serif;
}

.progress {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  padding: 12rpx 32rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 40rpx;
  display: inline-block;
  font-family: 'PingFang SC', sans-serif;
}

.question-number {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
  font-weight: 600;
  margin-bottom: 20rpx;
  font-family: 'PingFang SC', sans-serif;
}

.options-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-top: 30rpx;
}

.button-group {
  display: flex;
  gap: 20rpx;
  justify-content: center;
  margin-top: 40rpx;
}

.nav-button {
  flex: 1;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
  transition: all 0.3s ease;
  font-family: 'PingFang SC', sans-serif;
}

.prev-button {
  background: rgba(255, 255, 255, 0.2);
  color: #ffffff;
}

.next-button,
.submit-button {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #ffffff;
}

.nav-button:disabled {
  opacity: 0.5;
}

.nav-button:active:not(:disabled) {
  transform: scale(0.95);
}

.result-icon {
  font-size: 120rpx;
  margin-bottom: 40rpx;
  text-align: center;
}

.retry-button {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #ffffff;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
  font-family: 'PingFang SC', sans-serif;
}

.retry-button:active {
  transform: scale(0.95);
}
