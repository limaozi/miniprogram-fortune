/** constellation.wxss **/

page {
  background: radial-gradient(circle at top, #111827 0, #020617 50%, #000 100%);
  min-height: 100vh;
}

.constellation-container {
  width: 100%;
  min-height: 100vh;
  padding: 20rpx 20rpx;
  display: flex;
  flex-direction: column;
}

.constellation-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 60rpx;
  padding-top: 40rpx;
}

.title {
  font-size: 48rpx;
  font-weight: 600;
  color: #ffffff;
  margin-bottom: 20rpx;
  font-family: 'PingFang SC', sans-serif;
}

.question-counter {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.7);
  font-family: 'PingFang SC', sans-serif;
}

.question-container {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.question-card {
  background: rgba(255, 255, 255, 0.1);
  border-radius: 20rpx;
  padding: 40rpx;
  margin-bottom: 40rpx;
  backdrop-filter: blur(10px);
}

.question-text {
  font-size: 32rpx;
  color: #ffffff;
  line-height: 1.6;
  font-family: 'PingFang SC', sans-serif;
}

.picker-wrapper {
  flex: 1;
}

.picker-item {
  background: rgba(255, 255, 255, 0.1);
  border-radius: 15rpx;
  padding: 20rpx;
  border: 2rpx solid rgba(102, 126, 234, 0.3);
  color: #ffffff;
  text-align: center;
  font-size: 28rpx;
}

.options-container {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-bottom: 30rpx;
  margin-top: 30rpx;
}

.option-item {
  background: rgba(255, 255, 255, 0.1);
  border-radius: 15rpx;
  padding: 30rpx;
  border: 2rpx solid transparent;
  transition: all 0.3s ease;
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.option-item.selected {
  background: rgba(102, 126, 234, 0.3);
  border-color: #667eea;
  box-shadow: 0 0 20rpx rgba(102, 126, 234, 0.3);
}

.option-indicator {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.option-circle {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 3rpx solid rgba(255, 255, 255, 0.5);
  background: transparent;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
}

.option-circle.checked {
  border-color: #667eea;
  background: #667eea;
}

.option-checkmark {
  width: 20rpx;
  height: 20rpx;
  border: 3rpx solid #ffffff;
  border-top: none;
  border-right: none;
  transform: rotate(-45deg);
  margin-top: -4rpx;
}

.option-text {
  font-size: 30rpx;
  color: #ffffff;
  font-family: 'PingFang SC', sans-serif;
  flex: 1;
}

.button-container {
  margin-top: 20rpx;
  margin-bottom: 20rpx;
  text-align: center;
  align-items: center;
  justify-content: center;
  display: flex;
}

.submit-button {
  width: 100%;
  height: 100rpx;
  border-radius: 50rpx;
  border: none;
  background: rgba(255, 255, 255, 0.2);
  color: rgba(255, 255, 255, 0.5);
  font-size: 32rpx;
  font-weight: 500;
  transition: all 0.3s ease;
  text-align: center;
  align-items: center;
  justify-content: center;
  display: flex;
}

.submit-button.active {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #ffffff;
}

.submit-button:active {
  transform: scale(0.98);
}

.loading-container {
  width: 100%;
  height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: absolute;
  top: 0;
  left: 0;
  background: radial-gradient(circle at top, #111827 0, #020617 50%, #000 100%);
  z-index: 100;
}

.loader {
  width: 100rpx;
  height: 100rpx;
  border: 10rpx solid #f3f3f3;
  border-top: 10rpx solid #667eea;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

.loading-text {
  margin-top: 30rpx;
  font-size: 32rpx;
  color: #ffffff;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.result-swiper {
  width: 100%;
  height: 100vh;
}

.result-container {
  width: 100%;
  height: 100vh;
  padding: 40rpx 30rpx;
  display: flex;
  flex-direction: column;
  background: radial-gradient(circle at top, #111827 0, #020617 50%, #000 100%);
  box-sizing: border-box;
}

.result-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  margin-bottom: 30rpx;
  flex-shrink: 0;
}

.back-button {
  font-size: 32rpx;
  color: #ffffff;
  padding: 10rpx 20rpx;
  border-radius: 10rpx;
  background: rgba(255, 255, 255, 0.1);
}

.result-counter {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.7);
}

.result-content {
  background-color: rgba(0, 0, 0, 0.3);
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  width: 100%;
  box-sizing: border-box;
  flex: 1;
  overflow-y: auto;
}

.result-content .result-card {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  width: 100%;
  padding-bottom: 30rpx;
  box-sizing: border-box;
  color: #ffffff;
  font-size: 28rpx;
  line-height: 1.8;
  font-family: 'PingFang SC', sans-serif;
}

.result-card-title {
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
  color: #667eea;
}

.result-card-content {
  font-size: 28rpx;
  color: #ffffff;
  line-height: 1.8;
  font-family: 'PingFang SC', sans-serif;
}