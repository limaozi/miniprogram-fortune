/** constellation.wxss **/
page {
  background: radial-gradient(circle at top, #111827 0, #020617 50%, #000 100%);
  min-height: 100vh;
}

.constellation-container {
  width: 100%;
  min-height: 100vh;
  padding: 20rpx 20rpx;
  display: flex;
  flex-direction: column;
}

.constellation-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 60rpx;
  padding-top: 40rpx;
}

.constellation-title {
  font-size: 48rpx;
  font-weight: 600;
  color: #ffffff;
  margin-bottom: 20rpx;
  font-family: 'PingFang SC', sans-serif;
}

.title {
  font-size: 48rpx;
  font-weight: 600;
  color: #ffffff;
  margin-bottom: 20rpx;
  font-family: 'PingFang SC', sans-serif;
}

.picker-wrapper {
  flex: 1;
}

.picker-item {
  background: rgba(255, 255, 255, 0.1);
  border-radius: 15rpx;
  padding: 30rpx 20rpx;
  border: 2rpx solid rgba(102, 126, 234, 0.3);
  color: #ffffff;
  text-align: center;
  font-size: 36rpx;
  font-weight: 500;
}
.date-picker{
  font-size: 36rpx !important;
  height: 50px;
  padding: 0 20px;
}
.constellation-canvas {
  width: 300rpx;
  height: 300rpx;
  margin: 20rpx auto 30rpx auto;
  border-radius: 20rpx;
  overflow: hidden;
  display: block;
}
.constellation-result-type {
  font-size: 48rpx;
  font-weight: 700;
  color: #667eea;
  margin-bottom: 30rpx;
  font-family: 'PingFang SC', sans-serif;
  text-shadow: 0 0 20rpx rgba(102, 126, 234, 0.5);
  text-align: center;
  width: 100%;
}