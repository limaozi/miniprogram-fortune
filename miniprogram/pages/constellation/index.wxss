/** constellation.wxss **/

page {
  background: radial-gradient(circle at top, #111827 0, #020617 50%, #000 100%);
  min-height: 100vh;
}

.constellation-container {
  width: 100%;
  min-height: 100vh;
  padding: 20rpx 20rpx;
  display: flex;
  flex-direction: column;
}

.constellation-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 60rpx;
  padding-top: 40rpx;
}

.constellation-title {
  font-size: 48rpx;
  font-weight: 600;
  color: #ffffff;
  margin-bottom: 20rpx;
  font-family: 'PingFang SC', sans-serif;
}

.title {
  font-size: 48rpx;
  font-weight: 600;
  color: #ffffff;
  margin-bottom: 20rpx;
  font-family: 'PingFang SC', sans-serif;
}

.picker-wrapper {
  flex: 1;
}

.picker-item {
  background: rgba(255, 255, 255, 0.1);
  border-radius: 15rpx;
  padding: 30rpx 20rpx;
  border: 2rpx solid rgba(102, 126, 234, 0.3);
  color: #ffffff;
  text-align: center;
  font-size: 36rpx;
  font-weight: 500;
}
.date-picker{
  font-size: 36rpx !important;
  height: 50px;
  padding: 0 20px;
}
.result-container {
  width: 100%;
  height: 100vh;
  padding: 40rpx 30rpx;
  display: flex;
  flex-direction: column;
  background: radial-gradient(circle at top, #111827 0, #020617 50%, #000 100%);
  box-sizing: border-box;
}

.result-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0rpx 0;
  margin-bottom: 10rpx;
  flex-shrink: 0;
}

.result-content {
  background-color: rgba(0, 0, 0, 0.3);
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  width: 100%;
  box-sizing: border-box;
}

.result-content .result-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
  padding-bottom: 30rpx;
  box-sizing: border-box;
}

.result-buttons {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  flex-shrink: 0;
}

/* 回顾页面样式 */
.review-container {
  width: 100%;
  height: 100vh;
  padding: 0 20rpx;
  display: flex;
  flex-direction: column;
  background: radial-gradient(circle at top, #111827 0, #020617 50%, #000 100%);
  box-sizing: border-box;
}

.review-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  margin-bottom: 30rpx;
  flex-shrink: 0;
}

.review-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #ffffff;
  font-family: 'PingFang SC', sans-serif;
}

.swipe-hint-text-small {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
  font-family: 'PingFang SC', sans-serif;
}

.review-content {
  background-color: rgba(0, 0, 0, 0.3);
  border-radius: 20rpx;
  padding: 30rpx;
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
}

.review-list {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
  width: 100%;
  padding-bottom: 30rpx;
}

.review-item {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  width: 100%;
}

.review-question-card {
  background: rgba(255, 255, 255, 0.1);
  border-radius: 15rpx;
  backdrop-filter: blur(10px);
  width: 100%;
  box-sizing: border-box;
  padding: 15rpx;
}

.review-question-text {
  font-size: 30rpx;
  color: #ffffff;
  line-height: 1.6;
  font-family: 'PingFang SC', sans-serif;
  display: block;
}

.review-option-selected {
  background: rgba(102, 126, 234, 0.2);
  border-radius: 12rpx;
  padding: 20rpx;
  border: 2rpx solid #667eea;
  display: flex;
  align-items: center;
  width: 100%;
  box-sizing: border-box;
}

.review-option-text {
  font-size: 28rpx;
  color: #ffffff;
  font-family: 'PingFang SC', sans-serif;
  flex: 1;
}

.result-title {
  font-size: 32rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-bottom: 30rpx;
  font-family: 'PingFang SC', sans-serif;
}

.result-type {
  font-size: 72rpx;
  font-weight: 700;
  color: #667eea;
  margin-bottom: 30rpx;
  font-family: 'PingFang SC', sans-serif;
  text-shadow: 0 0 20rpx rgba(102, 126, 234, 0.5);
  text-align: center;
  width: 100%;
}

.result-description {
  font-size: 28rpx;
  color: #ffffff;
  line-height: 1.8;
  text-align: left;
  font-family: 'PingFang SC', sans-serif;
  margin-top: 30rpx;
  width: 100%;
  white-space: pre-wrap;
  word-wrap: break-word;
  box-sizing: border-box;
  padding: 0 20rpx;
}

.result-buttons .restart-button,
.result-buttons .back-button {
  width: 100%;
  height: 100rpx;
  border-radius: 50rpx;
  border: none;
  font-size: 32rpx;
  font-weight: 500;
  font-family: 'PingFang SC', sans-serif;
  text-align: center; 
  align-items: center; 
  justify-content: center;
  display: inline-flex;
}

.restart-button {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #ffffff;
}

.back-button {
  background: rgba(255, 255, 255, 0.2);
  color: #ffffff;
}

.restart-button:active,
.back-button:active {
  transform: scale(0.98)
  margin-bottom: 20rpx;
  color: #667eea;
}

.result-card-content {
  font-size: 28rpx;
  color: #ffffff;
  line-height: 1.8;
  font-family: 'PingFang SC', sans-serif;
}