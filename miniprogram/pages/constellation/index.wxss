/** constellation.wxss **/
page {
  background: radial-gradient(circle at top, #111827 0, #020617 50%, #000 100%);
  min-height: 100vh;
}

.constellation-container {
  width: 100%;
  min-height: 100vh;
  padding: 20rpx 20rpx;
  display: flex;
  flex-direction: column;
}

.constellation-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 60rpx;
  padding-top: 40rpx;
}

.constellation-title {
  font-size: 48rpx;
  font-weight: 600;
  color: #ffffff;
  margin-bottom: 20rpx;
  font-family: 'PingFang SC', sans-serif;
}

.title {
  font-size: 48rpx;
  font-weight: 600;
  color: #ffffff;
  margin-bottom: 20rpx;
  font-family: 'PingFang SC', sans-serif;
}

.picker-wrapper {
  flex: 1;
}

.picker-item {
  background: rgba(255, 255, 255, 0.1);
  border-radius: 15rpx;
  padding: 30rpx 20rpx;
  border: 2rpx solid rgba(102, 126, 234, 0.3);
  color: #ffffff;
  text-align: center;
  font-size: 36rpx;
  font-weight: 500;
}
.date-picker{
  font-size: 36rpx !important;
  height: 50px;
  padding: 0 20px;
}
.result-container {
  width: 100%;
  height: 100vh;
  padding: 40rpx 30rpx;
  display: flex;
  flex-direction: column;
  background: radial-gradient(circle at top, #111827 0, #020617 50%, #000 100%);
  box-sizing: border-box;
}

.result-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0rpx 0;
  margin-bottom: 10rpx;
  flex-shrink: 0;
}

.result-content {
  background-color: rgba(0, 0, 0, 0.3);
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  width: 100%;
  box-sizing: border-box;
}

.result-content .result-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
  padding-bottom: 30rpx;
  box-sizing: border-box;
}

.result-buttons {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  flex-shrink: 0;
}



 

 

 

.result-card-content {
  font-size: 28rpx;
  color: #ffffff;
  line-height: 1.8;
  font-family: 'PingFang SC', sans-serif;
}

.constellation-canvas {
  width: 300rpx;
  height: 300rpx;
  margin: 20rpx auto 30rpx auto;
  border-radius: 20rpx;
  overflow: hidden;
  display: block;
}
