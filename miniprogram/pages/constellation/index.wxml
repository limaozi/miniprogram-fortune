<view class="constellation-container">
  <view class="constellation-header">
    <text class="constellation-title">星座测试</text>
  </view>

  <view wx:if="{{!showResult && !isLoading}}" class="question-container">
    <view class="question-card">
      <view class="question-text">请选择你的生日</view>
      <view style="margin-top: 10rpx;">
        <picker mode="date" value="{{selectedDate}}" start="1900-01-01" end="{{currentDate}}" bindchange="onDateChange" class="date-picker">
          <view class="picker-item">{{selectedDate || '选择生日日期'}}</view>
        </picker>
      </view>
    </view>
  </view>

  <view wx:if="{{!showResult && !isLoading}}" class="question-container">
    <view class="question-card">
      <view class="question-text">请选择你的性别</view>
      <view class="options-container">
        <view class="option-item {{selectedGender === 'male' ? 'selected' : ''}}" bindtap="selectGender" data-gender="male">
          <view class="option-indicator">
            <view class="option-circle {{selectedGender === 'male' ? 'checked' : ''}}"></view>
          </view>
          <view class="option-text">男</view>
        </view>
        <view class="option-item {{selectedGender === 'female' ? 'selected' : ''}}" bindtap="selectGender" data-gender="female">
          <view class="option-indicator">
            <view class="option-circle {{selectedGender === 'female' ? 'checked' : ''}}"></view>
          </view>
          <view class="option-text">女</view>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{!showResult && !isLoading}}" class="button-container">
    <button class="submit-button {{selectedYear && selectedMonth && selectedDay && selectedGender ? 'active' : ''}}" bindtap="onSubmit">生成星座</button>
  </view>

  <!-- Spinner shown during API loading -->
  <view class="spinner-bottom" wx:if="{{isLoading}}">
    <!-- 加载状态 -->
    <view class="loading-container">
      <view class="loading-spinner"></view>
      <text class="loading-text">{{loadingText}}</text>
    </view>
  </view>

  <swiper 
    class="result-swiper" 
    wx:if="{{showResult && !isLoading}}"
    current="{{resultPage}}"
    bindchange="onResultSwiperChange"
    style="height: 100vh;"
  >
    <!-- 回顾页面：显示输入信息 -->
    <swiper-item>
      <view class="review-container">
        <view class="review-header">
          <text class="review-title">测试信息</text>
          <text class="swipe-hint-text-small">右滑查看结果 →</text>
        </view>
        <scroll-view 
          class="review-content" 
          scroll-y="{{true}}"
          show-scrollbar="{{true}}"
          enhanced="{{true}}"
          bounces="{{false}}"
          enable-back-to-top="{{false}}"
          style="height: {{reviewScrollHeight}}rpx;"
        >
          <view class="review-list">
            <view class="review-item">
              <view class="review-question-card">
                <text class="review-question-text">生日日期</text>
              </view>
              <view class="review-option-selected">
                <text class="review-option-text review-option.selected">{{selectedYear}}-{{selectedMonth}}-{{selectedDay}}</text>
              </view>
            </view>
            <view class="review-item">
              <view class="review-question-card">
                <text class="review-question-text">性别</text>
              </view>
              <view class="review-option-selected">
                <text class="review-option-text review-option.selected">{{selectedGender === 'male' ? '男' : '女'}}</text>
              </view>
            </view>
          </view>
        </scroll-view>
      </view>
    </swiper-item>
    
    <!-- 结果页面：显示星座类型和分析 -->
    <swiper-item>
      <view class="result-container">
        <view class="result-header">
          <text class="result-title">您的星座类型</text>
          <text class="swipe-hint-text-small">← 左滑返回</text>
        </view>
        <scroll-view 
          class="result-content" 
          scroll-y="{{true}}"
          show-scrollbar="{{true}}"
          enhanced="{{true}}"
          bounces="{{false}}"
          enable-back-to-top="{{false}}"
          style="height: {{resultScrollHeight}}rpx;"
        >
          <view class="result-card">
            <text class="constellation-result-type">{{constellationType}}</text>
            <canvas
              type="2d"
              id="constellationCanvas"
              class="constellation-canvas"
            ></canvas>
            <text class="result-description">{{constellationDescription}}</text>
          </view>
        </scroll-view>
        <view class="result-buttons">
          <button class="restart-button" bindtap="restartTest">重新测试</button>
          <button class="back-button" bindtap="goBack">返回首页</button>
        </view>
      </view>
    </swiper-item>
  </swiper>
</view>