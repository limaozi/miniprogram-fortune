.style-container {
  width: 100%;
  min-height: 100vh;
  padding: 20rpx 20rpx;
  display: flex;
  flex-direction: column;
}
.style-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 40rpx;
  padding-top: 40rpx;
}
.style-title {
  font-size: 44rpx;
  font-weight: 600;
  color: #ffffff;
  margin-bottom: 10rpx;
}

.option-swatch {
  width: 32rpx;
  height: 32rpx;
  border-radius: 8rpx;
  margin: 0 16rpx 0 8rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.4);
  box-shadow: 0 4rpx 8rpx rgba(0, 0, 0, 0.15);
}
