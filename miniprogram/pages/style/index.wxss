.style-container {
  width: 100%;
  min-height: 100vh;
  padding: 20rpx 20rpx;
  display: flex;
  flex-direction: column;
  background: radial-gradient(circle at top, #111827 0, #020617 50%, #000 100%);
}

.style-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 60rpx;
  padding-top: 40rpx;
}

.style-title {
  font-size: 48rpx;
  font-weight: 600;
  color: #ffffff;
  margin-bottom: 20rpx;
  font-family: 'PingFang SC', sans-serif;
}


.option-swatch {
  width: 32rpx;
  height: 32rpx;
  border-radius: 8rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.4);
  box-shadow: 0 4rpx 8rpx rgba(0, 0, 0, 0.15);
  flex-shrink: 0;
}



