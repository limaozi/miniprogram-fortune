<!-- 入口页面 -->
<view class="home-container">
  <view class="title">宝藏之地</view>
  <view class="date-season">
    <text class="date-text">{{currentDateStr}}</text>
    <text class="season-text"> · {{currentSeasonZh}}</text>
  </view>

  <view class="weather-row">
    <text class="weather-city" wx:if="{{cityName && !cityLoading}}">{{cityName}} · </text>
    <text class="weather-city" wx:elif="{{cityLoading}}">正在解析地址 · </text>
    <text class="weather-text" wx:if="{{weatherText && !weatherLoading}}">{{weatherText}}</text>
    <text class="weather-text" wx:elif="{{weatherLoading}}">正在解析天气</text>
    <text class="weather-temp" wx:if="{{weatherTemp && !weatherLoading}}">{{weatherTemp}}</text>
  </view>
  <view class="weather-row">
    <text class="weather-city">进入下方测试，解锁当月运势</text>
  </view>
  <!-- 3行2列布局 -->
  <view class="grid-container">
    <button class="home-button tarot-button" bindtap="goToTarot">
      <text class="button-text">塔罗命运</text>
    </button>
    
    <button class="home-button mbti-button" bindtap="goToMBTI">
      <text class="button-text">MBTI测试</text>
    </button>
    
    <button class="home-button love-button" bindtap="goToLove">
      <text class="button-text">情感咨询</text>
    </button>
    
    <button class="home-button constellation-button" bindtap="goToConstellation">
      <text class="button-text">星座测试</text>
    </button>
    
    <button class="home-button style-button" bindtap="goToStyle">
      <text class="button-text">穿搭建议</text>
    </button>
    
    <button class="home-button destiny-button" bindtap="goToDestiny">
      <text class="button-text">角色命运</text>
    </button>
  </view>
</view>
