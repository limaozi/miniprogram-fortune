/** home.wxss **/

page {
  background: radial-gradient(circle at top, #111827 0, #020617 50%, #000 100%);
  min-height: 100vh;
}

.home-container {
  width: 100%;
  height: 100vh;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  padding: 40rpx 0;
  box-sizing: border-box;
}

.title {
  font-size: 56rpx;
  font-weight: 600;
  color: #ffffff;
  margin-bottom: 80rpx;
  font-family: 'PingFang SC', sans-serif;
  text-shadow: 0 0 20rpx rgba(102, 126, 234, 0.5);
}

/* 五瓣梅花布局 */
.plum-container {
  position: relative;
  width: 600rpx;
  height: 600rpx;
  margin: 80rpx auto;
}

.home-button {
  position: absolute;
  width: 180rpx !important;
  height: 180rpx !important;
  border-radius: 50%;
  box-sizing: border-box;
  padding: 0;
  margin: 0;
  border: none;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  font-size: 36rpx;
  font-weight: 500;
  transition: all 0.3s ease;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.3);
}

/* 梅花瓣位置（五瓣均匀分布） */
.petal-top {
  top: 0;
  left: 50%;
  transform: translate(-50%, 0) !important; /* 水平居中 */
}

.petal-right-top {
  top: 120rpx;    /* 调整位置 */
  right: 60rpx;
  transform: none !important; /* 清除可能继承的transform */
}

.petal-right-bottom {
  bottom: 120rpx;
  right: 115rpx;
  transform: none !important;
}

.petal-left-bottom {
  bottom: 120rpx;
  left: 115rpx;
  transform: none !important;
}

.petal-left-top {
  top: 120rpx;
  left: 60rpx;
  transform: none !important;
}

.tarot-button {
  background: linear-gradient(135deg, #7083d6 0%, #8e4ba2 100%);
  color: #ffffff;
}

.tarot-button:active {
  transform: translate(-50%, 0) scale(0.95) !important; /* 保持水平居中 */
  box-shadow: 0 12rpx 30rpx rgba(102, 126, 234, 0.4);
}

.mbti-button {
  background: linear-gradient(135deg, #ff5d51 0%, #ffb759 100%);
  color: #ffffff;
}

.mbti-button:active {
  transform: scale(0.95);
  box-shadow: 0 12rpx 30rpx rgba(245, 87, 108, 0.4);
}

.constellation-button {
  background: linear-gradient(135deg, #e7634c 0%, #f5dd57 100%);
  color: #ffffff;
}

.constellation-button:active {
  transform: scale(0.95);
  box-shadow: 0 12rpx 30rpx rgba(87, 116, 245, 0.4);
}

.style-button {
  background: linear-gradient(135deg, #7f43ce 0%, #d82a7b 100%);
  color: #ffffff;
}

.style-button:active {
  transform: scale(0.95);
  box-shadow: 0 12rpx 30rpx rgba(67, 206, 162, 0.4);
}

.love-button {
  background: linear-gradient(135deg, #ffa16b 0%, #e4534e 100%);
  color: #ffffff;
}

.love-button:active {
  transform: scale(0.95);
  box-shadow: 0 12rpx 30rpx rgba(255, 107, 157, 0.4);
}

.button-text {
  font-family: 'PingFang SC', sans-serif;
  text-align: center;
  font-size: 30rpx;
  line-height: 1.4;
}
