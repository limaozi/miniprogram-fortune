/** home.wxss **/

page {
  background: radial-gradient(circle at top, #111827 0, #020617 50%, #000 100%);
  min-height: 100vh;
}

.home-container {
  width: 100%;
  height: 100vh;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  padding: 40rpx 0;
  box-sizing: border-box;
}

.title {
  font-size: 56rpx;
  font-weight: 600;
  color: #ffffff;
  margin-bottom: 20rpx;
  font-family: 'PingFang SC', sans-serif;
  text-shadow: 0 0 20rpx rgba(102, 126, 234, 0.5);
}

.date-season {
  flex-direction: row;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 40rpx;
}

.date-text {
  font-size: 30rpx;
  color: rgba(255, 255, 255, 0.9);
  font-family: 'PingFang SC', sans-serif;
}

.season-text {
  font-size: 30rpx;
  color: rgba(255, 255, 255, 0.7);
  font-family: 'PingFang SC', sans-serif;
}

.weather-row {
  flex-direction: row;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
  gap: 16rpx;
}

.weather-city {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.85);
  font-family: 'PingFang SC', sans-serif;
}

.weather-text {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.85);
  font-family: 'PingFang SC', sans-serif;
}

.weather-temp {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
  font-family: 'PingFang SC', sans-serif;
  font-weight: 500;
}

.weather-loading .season-text,
.weather-error .season-text {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.6);
}

/* 3行2列布局 */
.grid-container {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  grid-template-rows: repeat(3, 120rpx);
  gap: 24rpx;
  width: 85%;
  max-width: 320rpx;
  margin: 80rpx auto;
  justify-content: center;
  align-content: center;
}

.home-button {
  width: 100%;
  height: 100%;
  border-radius: 24rpx;
  box-sizing: border-box;
  padding: 0;
  margin: 0;
  border: none;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  font-size: 32rpx;
  font-weight: 500;
  transition: all 0.3s ease;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.3);
}

.tarot-button {
  background: linear-gradient(135deg, #3b51b6 0%, #8e4ba2 100%);
  color: #ffffff;
}

.tarot-button:active {
  transform: scale(0.95);
  box-shadow: 0 12rpx 30rpx rgba(102, 126, 234, 0.4);
}

.mbti-button {
  background: linear-gradient(135deg, #bb473f 0%, #d3ae35 100%);
  color: #ffffff;
}

.mbti-button:active {
  transform: scale(0.95);
  box-shadow: 0 12rpx 30rpx rgba(245, 87, 108, 0.4);
}

.constellation-button {
  background: linear-gradient(135deg, #684ce7 0%, #af58e2 100%);
  color: #ffffff;
}

.constellation-button:active {
  transform: scale(0.95);
  box-shadow: 0 12rpx 30rpx rgba(87, 116, 245, 0.4);
}

.style-button {
  background: linear-gradient(135deg, #7f43ce 0%, #d82a7b 100%);
  color: #ffffff;
}

.style-button:active {
  transform: scale(0.95);
  box-shadow: 0 12rpx 30rpx rgba(67, 206, 162, 0.4);
}

.love-button {
  background: linear-gradient(135deg, #ffa16b 0%, #e4534e 100%);
  color: #ffffff;
}

.love-button:active {
  transform: scale(0.95);
  box-shadow: 0 12rpx 30rpx rgba(255, 107, 157, 0.4);
}

.button-text {
  font-family: 'PingFang SC', sans-serif;
  text-align: center;
  font-size: 30rpx;
  line-height: 1.4;
}

.destiny-button {
  background: linear-gradient(135deg, #f59e0b 0%, #ef4444 100%);
  color: #ffffff;
}

.destiny-button:active {
  transform: scale(0.95);
  box-shadow: 0 12rpx 30rpx rgba(245, 158, 11, 0.4);
}
